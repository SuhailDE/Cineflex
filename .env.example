# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas or local MongoDB connection string.
# When omitted, CineFlix persists data to backend/data/cineflix-db.json automatically.
MONGODB_URI=

# ADMIN_PASSCODE: Optional administrator claim/sign-in passcode.
# If unset, the first user can claim the Admin account directly in the UI.
ADMIN_PASSCODE=

# REDIS_URL: Optional Redis connection URL for distributed caching.
REDIS_URL=

# CLOUDINARY_CLOUD_NAME: Optional Cloudinary cloud name for media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
